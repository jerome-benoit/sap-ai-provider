{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:daily"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchFileNames": ["**/package.json"],
      "matchDepTypes": ["dependencies", "optionalDependencies"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Pin the @ai-sdk/provider-v2 alias to @ai-sdk/provider v2 (LanguageModelV2/EmbeddingModelV2 types)",
      "matchDepTypes": ["devDependencies"],
      "matchDepNames": ["@ai-sdk/provider-v2"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "postUpdateOptions": ["npmDedupe"]
}
