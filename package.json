{
  "name": "@jerome-benoit/sap-ai-provider",
  "version": "5.0.2",
  "type": "module",
  "description": "SAP AI Provider for Vercel AI SDK (powered by @sap-ai-sdk/orchestration and @sap-ai-sdk/foundation-models)",
  "keywords": [
    "ai",
    "vercel",
    "vercel-ai-sdk",
    "sap",
    "sap-ai-core",
    "sap-ai-sdk",
    "aicore",
    "btp",
    "cap",
    "agent",
    "orchestration"
  ],
  "homepage": "https://github.com/jerome-benoit/sap-ai-provider#readme",
  "bugs": {
    "url": "https://github.com/jerome-benoit/sap-ai-provider/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerome-benoit/sap-ai-provider.git"
  },
  "license": "Apache-2.0",
  "author": "jerome-benoit",
  "volta": {
    "node": "24.21.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v2": {
      "import": {
        "types": "./dist/index-v2.d.ts",
        "default": "./dist/index-v2.js"
      },
      "require": {
        "types": "./dist/index-v2.d.cts",
        "default": "./dist/index-v2.cjs"
      }
    },
    "./v3": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./v4": {
      "import": {
        "types": "./dist/index-v4.d.ts",
        "default": "./dist/index-v4.js"
      },
      "require": {
        "types": "./dist/index-v4.d.cts",
        "default": "./dist/index-v4.cjs"
      }
    }
  },
  "directories": {
    "example": "examples"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "build:v2": "tsup --config tsup.config.v2.ts",
    "build:v2:watch": "tsup --config tsup.config.v2.ts --watch",
    "check-build": "ls -la dist/ && test -f dist/index.js && test -f dist/index.cjs && test -f dist/index.d.ts && test -f dist/index.d.cts && test -f dist/index-v2.js && test -f dist/index-v2.cjs && test -f dist/index-v2.d.ts && test -f dist/index-v2.d.cts && test -f dist/index-v4.js && test -f dist/index-v4.cjs && test -f dist/index-v4.d.ts && test -f dist/index-v4.d.cts && tsx scripts/check-package-exports.ts",
    "check-build:v2": "ls -la dist/ && test -f dist/index-v2.js && test -f dist/index-v2.cjs && test -f dist/index-v2.d.ts && test -f dist/index-v2.d.cts",
    "check-build:v4": "ls -la dist/ && test -f dist/index-v4.js && test -f dist/index-v4.cjs && test -f dist/index-v4.d.ts && test -f dist/index-v4.d.cts",
    "clean": "rm -rf dist",
    "lint": "npm run lint:md:all && eslint . --cache",
    "lint-fix": "npm run lint:md:fix && eslint . --fix --cache",
    "lint:md": "markdownlint-cli2 '**/*.md'",
    "lint:md:all": "npm run lint:md && npm run lint:md:toc && npm run lint:md:mermaid",
    "lint:md:fix": "markdownlint-cli2 --fix '**/*.md'",
    "lint:md:links": "find . -name '*.md' -not -path './node_modules/*' -exec sh -c 'status=0; for file; do markdown-link-check -c .markdown-link-check.json \"$file\" || status=1; done; exit \"$status\"' sh {} +",
    "lint:md:mermaid": "find . -name '*.md' -not -path './node_modules/*' -exec sh -c 'status=0; for file; do mermaid-validate validate-md \"$file\" || status=1; done; exit \"$status\"' sh {} +",
    "lint:md:toc": "tsx scripts/check-toc.ts",
    "prepare:v2": "tsx scripts/prepare-v2-package.ts",
    "prepublishOnly": "if [ \"$AI_SDK_VERSION\" = \"v2\" ]; then npm run build:v2 && npm run check-build:v2 && npm run prepare:v2 && tsx scripts/check-package-exports.ts; else npm run build && npm run check-build; fi",
    "prettier-check": "prettier --cache --check .",
    "prettier-fix": "prettier --cache --write .",
    "test": "vitest run",
    "test:coverage": "vitest --config vitest.node.config.ts --run --coverage",
    "test:edge": "vitest --config vitest.edge.config.ts --run",
    "test:node": "vitest --config vitest.node.config.ts --run",
    "test:node:watch": "vitest --config vitest.node.config.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.14",
    "@ai-sdk/provider-utils": "^5.0.40",
    "@sap-ai-sdk/ai-api": "^2.15.0",
    "@sap-ai-sdk/core": "^2.15.0",
    "@sap-ai-sdk/foundation-models": "^2.15.0",
    "@sap-ai-sdk/orchestration": "^2.15.0",
    "@sap-cloud-sdk/connectivity": "^4.9.1",
    "@sap-cloud-sdk/util": "^4.9.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@ai-sdk/provider-v2": "npm:@ai-sdk/provider@^2.0.4",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.6",
    "@vitest/coverage-v8": "^5.0.0",
    "ai": "^7.0.99",
    "dotenv": "^17.4.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.10",
    "eslint-plugin-perfectionist": "^5.11.0",
    "github-slugger": "^2.0.0",
    "globals": "^17.12.0",
    "lefthook": "^2.1.12",
    "markdown-it": "^15.0.2",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.23.2",
    "mermaid-validate": "^1.3.2",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "ai": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
